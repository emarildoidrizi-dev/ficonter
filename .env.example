# Public Supabase application connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase administration key. Use one of these names.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FICONTER application configuration
NEXT_PUBLIC_SITE_URL=
FICONTER_OWNER_EMAIL=
FICONTER_SUPER_ADMIN_EMAIL=

# Optional server-only monitoring token for authenticated deep health checks.
# Never expose this value through NEXT_PUBLIC_* variables.
FICONTER_HEALTH_TOKEN=

# Smart Insights configuration
OPENAI_API_KEY=
OPENAI_MODEL=
