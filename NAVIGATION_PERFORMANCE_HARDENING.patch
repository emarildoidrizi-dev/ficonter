+.card {
+  width: min(680px, 100%);
+  margin: 32px auto;
+  padding: 24px;
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 14px 16px;
+  border: 1px solid var(--line);
+  border-radius: 22px;
