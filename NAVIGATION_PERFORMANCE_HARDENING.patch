+  width: 42px;
+  height: 42px;
+  display: grid;
+  place-items: center;
+  border-radius: 14px;
+  background: color-mix(in srgb, currentColor 8%, transparent);
+}
+
+.copy { min-width: 0; }
+.eyebrow {
+  display: block;
